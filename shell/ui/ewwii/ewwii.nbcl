Window "onyrion-quicksettings-0" {
    monitor = 0
    stacking = "overlay"
    exclusive = false
    focusable = "exclusive"
    namespace = "onyrion-quicksettings-0"

    geometry = {
        x = "12px"
        y = "52px"
        width = "360px"
        anchor = "top right"
    }

    Box {
        orientation = "v"
        space_evenly = false
        spacing = 10
        class = "onyrion-quicksettings"

        Label "onyrion-quicksettings-title-0" {
            text = "Quick Settings"
            class = "onyrion-quicksettings-title"
        }

        Button "onyrion-quicksettings-wifi-0" {
            label = global("onyrion_control").mutate(|raw| {
                return onyrion_scalar_project("control", "wifi.display", raw)
            })
            onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} wifi toggle"
