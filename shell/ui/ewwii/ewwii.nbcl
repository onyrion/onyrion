            class = "onyrion-quicksettings-audio-actions"

            Button "onyrion-audio-sink-down-7" {
                label = "Vol -"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio sink volume change -0.05"
            }

            Button "onyrion-audio-sink-mute-7" {
                label = "Mute"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio sink mute toggle"
            }

            Button "onyrion-audio-sink-up-7" {
                label = "Vol +"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio sink volume change 0.05"
            }
        }

        Label "onyrion-quicksettings-audio-source-7" {
            text = global("onyrion_audio").mutate(|raw| {
                return onyrion_scalar_project("audio", "source.display", raw)
            })
        }

        Box {
            spacing = 8
            class = "onyrion-quicksettings-audio-actions"

            Button "onyrion-audio-source-down-7" {
                label = "Mic -"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio source volume change -0.05"
            }

            Button "onyrion-audio-source-mute-7" {
                label = "Mic mute"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio source mute toggle"
            }

            Button "onyrion-audio-source-up-7" {
                label = "Mic +"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio source volume change 0.05"
            }
        }

        Label "onyrion-quicksettings-battery-7" {
            text = global("onyrion_control").mutate(|raw| {
                return onyrion_scalar_project("control", "battery.display", raw)
            })
        }

        Label "onyrion-quicksettings-power-state-7" {
            text = global("onyrion_control").mutate(|raw| {
                return onyrion_scalar_project("control", "power_profile.display", raw)
            })
        }

        Box {
            spacing = 8
            class = "onyrion-quicksettings-profiles"

            Button "onyrion-profile-power-saver-7" {
                label = "Saver"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} power-profile set power-saver"
            }

            Button "onyrion-profile-balanced-7" {
                label = "Balanced"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} power-profile set balanced"
            }

            Button "onyrion-profile-performance-7" {
                label = "Performance"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} power-profile set performance"
            }
        }

        Button "onyrion-quicksettings-audio-mixer-7" {
            label = "Audio mixer"
            onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} open --screen 7 --toggle onyrion-audio-mixer"
            class = "onyrion-shell-control"
        }

        Button "onyrion-quicksettings-close-7" {
            label = "Close"
            onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} close onyrion-quicksettings-7"
            class = "onyrion-quicksettings-close"
        }
    }
}

Window "onyrion-powermenu" {
    monitor = 0
    stacking = "overlay"
    focusable = "exclusive"

    geometry = {
        width = "320px"
        height = "280px"
        anchor = "center"
    }

    Box {
        orientation = "v"
        spacing = 8
        class = "onyrion-powermenu"

        Label {
            text = "Session"
        }

        Button "onyrion-power-lock" {
            label = "Lock"
            onclick = "onyrion-shell lock"
        }

        Button "onyrion-power-logout" {
            label = "Logout"
            onclick = "onyrion-shell power logout"
        }

        Button "onyrion-power-suspend" {
            label = "Suspend"
            onclick = "onyrion-shell power suspend"
        }

        Button "onyrion-power-reboot" {
            label = "Reboot"
            onclick = "onyrion-shell power reboot"
        }

        Button "onyrion-power-poweroff" {
            label = "Power off"
            onclick = "onyrion-shell power poweroff"
        }
    }
}

Window "onyrion-audio-mixer" {
    monitor = 0
    stacking = "overlay"
    exclusive = false
    focusable = "none"
    namespace = "onyrion-audio-mixer"

    geometry = {
        x = "12px"
        y = "52px"
        width = "440px"
        height = "10px"
        anchor = "top right"
    }

    Box {
        orientation = "v"
        spacing = 0
        class = "onyrion-quicksettings"

        Label "onyrion-audio-mixer-title" {
            text = "Audio mixer"
            class = "onyrion-quicksettings-title"
        }

        Label "onyrion-audio-devices-ingest-anchor" {
            text = ""
            class = global("onyrion_audio_devices").mutate(|raw| {
                return onyrion_audio_devices_ingest(raw)
            })
        }

        Label "onyrion-audio-streams-ingest-anchor" {
            text = ""
            class = global("onyrion_audio_streams").mutate(|raw| {
                return onyrion_audio_streams_ingest(raw)
            })
        }

        Custom {
            name = "onyrion-audio-dynamic"
        }

        Button "onyrion-audio-mixer-close" {
            label = "Close"
            onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} close onyrion-audio-mixer"
            class = "onyrion-quicksettings-close onyrion-audio-mixer-spaced"
        }
    }
}

