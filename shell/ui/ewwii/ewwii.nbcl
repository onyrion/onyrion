import core.json

Listen "onyrion_state" {
    initial = "{\"generation\":0,\"block\":\"bar\",\"modules\":[\"workspaces\",\"groups\"],\"outputs\":[]}"
    cmd = "${ONYRION_SHELL_BIN:-onyrion-shell} watch-state --ewwii ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii}"
}

Listen "onyrion_tray" {
    initial = "{\"items\":[]}"
    cmd = "${ONYRION_TRAY_BIN:-onyrion-shell} tray watch"
}

Listen "onyrion_status" {
    initial = "{\"clock\":\"--:--\",\"battery\":\"BAT --\",\"network\":\"NET --\",\"audio\":\"VOL --\",\"audio_source\":\"none\"}"
    cmd = "${ONYRION_SHELL_BIN:-onyrion-shell} watch-status"
}

Listen "onyrion_control" {
    initial = "{\"wifi\":{\"available\":false,\"enabled\":false,\"hardware_enabled\":false,\"connection\":null,\"display\":\"Wi-Fi · unavailable\"},\"bluetooth\":{\"available\":false,\"powered\":false,\"alias\":null,\"display\":\"Bluetooth · unavailable\",\"devices\":[]},\"power_profile\":{\"available\":false,\"active\":null,\"display\":\"Power profile · unavailable\",\"profiles\":[]},\"battery\":{\"available\":false,\"percentage\":0,\"state\":0,\"time_to_full\":0,\"time_to_empty\":0,\"icon\":null,\"display\":\"Battery · unavailable\"}}"
    cmd = "${ONYRION_CONTROL_BIN:-onyrion-control} watch"
}

Listen "onyrion_audio" {
    initial = "{\"sink\":{\"available\":false,\"name\":null,\"description\":null,\"volume\":0,\"muted\":false,\"backend\":\"unavailable\",\"display\":\"VOL --\"},\"source\":{\"available\":false,\"name\":null,\"description\":null,\"volume\":0,\"muted\":false,\"backend\":\"unavailable\",\"display\":\"MIC --\"}}"
    cmd = "${ONYRION_CONTROL_BIN:-onyrion-control} audio watch"
}

Listen "onyrion_audio_devices" {
    initial = "{\"default_sink\":null,\"default_source\":null,\"configured_sink\":null,\"configured_source\":null,\"outputs\":[],\"inputs\":[]}"
    cmd = "${ONYRION_CONTROL_BIN:-onyrion-control} audio devices watch"
}

Listen "onyrion_audio_streams" {
    initial = "{\"playback\":[],\"capture\":[]}"
    cmd = "${ONYRION_CONTROL_BIN:-onyrion-control} audio streams watch"
}

Listen "onyrion_wifi_networks" {
    initial = "{\"available\":false,\"enabled\":false,\"hardware_enabled\":false,\"device\":null,\"device_path\":null,\"active_bssid\":null,\"active_ssid\":null,\"last_scan\":-1,\"networks\":[]}"
    cmd = "${ONYRION_CONTROL_BIN:-onyrion-control} wifi networks watch"
}

Window "onyrion-bootstrap" {
    monitor = 0
    stacking = "bg"
    exclusive = false
    focusable = "none"
    namespace = "onyrion-bootstrap"

    geometry = {
        width = "1px"
        height = "1px"
        anchor = "bottom left"
    }

    Box {
        class = "onyrion-bootstrap"
        can_target = false
    }
}

Window "onyrion-tabgroup" {
    force_normal = true
    resizable = false

    geometry = {
        width = "1px"
        height = "1px"
        anchor = "top left"
    }

    Box {
        class = "onyrion-tabgroup-bootstrap"
        can_target = false
    }
}

Window "onyrion-notifications" {
    monitor = 0
    stacking = "overlay"
    exclusive = false
    focusable = "none"

    geometry = {
        x = "16px"
        y = "56px"
        width = "420px"
        anchor = "top right"
    }

    Box {
        widget_name = "onyrion-notification-list"
        orientation = "v"
        spacing = 10
        class = "onyrion-notifications"
    }
}
Window "onyrion-background" {
    monitor = 0
    stacking = "bg"
    exclusive = false
    focusable = "none"

    geometry = {
        width = "100%"
        height = "100%"
        anchor = "center"
    }

    Image "onyrion-wallpaper" {
        path = global("onyrion_wallpaper")
        content_fit = "cover"
        preserve_aspect_ratio = true
        can_shrink = true
        can_target = false
        hexpand = true
        vexpand = true
        class = "onyrion-wallpaper"
    }
}

Window "onyrion-bar-0" {
    monitor = 0
    stacking = "fg"
    exclusive = true
    focusable = "none"
    namespace = "onyrion-bar-0"

    geometry = {
        width = "100%"
        height = "40px"
        anchor = "top center"
    }

    Box {
        class = "onyrion-bar"
        spacing = 8
        hexpand = true

        Box {
            class = "onyrion-bar-left"
            spacing = 8
            halign = "start"

            Label {
                text = "Onyrion"
                class = "onyrion-brand"
            }

            Custom {
                name = "onyrion-bar-workspaces-0"
            }

        }

        Custom {
            name = "onyrion-bar-groups-0"
        }

        Box {
            class = "onyrion-bar-right"
            spacing = 4
            halign = "end"


            Button "onyrion-launcher-0" {
                label = "Apps"
                onclick = "${ONYRION_SHELL_BIN:-onyrion-shell} invoke ui:launcher toggle"
                class = "onyrion-shell-control onyrion-launcher-control"
            }


            Label "onyrion-tray-ingest-anchor" {
                text = ""
                class = global("onyrion_tray").mutate(|raw| {
                    return onyrion_tray_ingest(raw)
                })
            }

            Custom {
                name = "onyrion-tray-dynamic-0"
            }

            EventBox "onyrion-clock-0" {

                onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} open onyrion-calendar-0 --toggle"

                class = "onyrion-clock-button"


                Label "onyrion-clock-label-0" {

                    text = global("onyrion_status").mutate(|raw| {

                        return onyrion_scalar_project("status", "clock", raw)

                    })

                }

            }

            Button "onyrion-quicksettings-open-0" {
                label = "QS"
                onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} open onyrion-quicksettings-0 --toggle"
                class = "onyrion-shell-control onyrion-quicksettings-control"
            }
        }
    }
}

