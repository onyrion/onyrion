Window "onyrion-quicksettings-0" {
    monitor = 0
    stacking = "overlay"
    exclusive = false
    focusable = "none"
    namespace = "onyrion-quicksettings-0"

    geometry = {
        x = "12px"
        y = "52px"
        width = "360px"
        height = "10px"
        anchor = "top right"
    }

    Box {
        orientation = "v"
        spacing = 10
        class = "onyrion-quicksettings"

        Label "onyrion-quicksettings-title-0" {
            text = "Quick Settings"
            class = "onyrion-quicksettings-title"
        }

        Label "onyrion-quicksettings-wifi-state-0" {
            text = global("onyrion_control").mutate(|raw| {
                return onyrion_scalar_project("control", "wifi.display", raw)
            })
        }

        Button "onyrion-quicksettings-wifi-toggle-0" {
            label = "Toggle Wi-Fi"
            onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} wifi toggle"
        }

        Button "onyrion-quicksettings-wifi-networks-0" {
            label = "Wi-Fi networks"
            onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} open --screen 0 --toggle onyrion-wifi-networks"
            class = "onyrion-shell-control"
        }

        Label "onyrion-quicksettings-bluetooth-state-0" {
            text = global("onyrion_control").mutate(|raw| {
                return onyrion_scalar_project("control", "bluetooth.display", raw)
            })
        }

        Button "onyrion-quicksettings-bluetooth-toggle-0" {
            label = "Toggle Bluetooth"
            onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} bluetooth toggle"
        }

        Button "onyrion-quicksettings-bluetooth-devices-0" {
            label = "Bluetooth devices"
            onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} open --screen 0 --toggle onyrion-bluetooth-devices"
            class = "onyrion-shell-control"
        }

        Label "onyrion-quicksettings-audio-sink-0" {
            text = global("onyrion_audio").mutate(|raw| {
                return onyrion_scalar_project("audio", "sink.display", raw)
            })
        }

        Box {
            spacing = 8
            class = "onyrion-quicksettings-audio-actions"

            Button "onyrion-audio-sink-down-0" {
                label = "Vol -"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio sink volume change -0.05"
            }

            Button "onyrion-audio-sink-mute-0" {
                label = "Mute"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio sink mute toggle"
            }

            Button "onyrion-audio-sink-up-0" {
                label = "Vol +"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio sink volume change 0.05"
            }
        }

        Label "onyrion-quicksettings-audio-source-0" {
            text = global("onyrion_audio").mutate(|raw| {
                return onyrion_scalar_project("audio", "source.display", raw)
            })
        }

        Box {
            spacing = 8
            class = "onyrion-quicksettings-audio-actions"

            Button "onyrion-audio-source-down-0" {
                label = "Mic -"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio source volume change -0.05"
            }

            Button "onyrion-audio-source-mute-0" {
                label = "Mic mute"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio source mute toggle"
            }

            Button "onyrion-audio-source-up-0" {
                label = "Mic +"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} audio source volume change 0.05"
            }
        }

        Label "onyrion-quicksettings-battery-0" {
            text = global("onyrion_control").mutate(|raw| {
                return onyrion_scalar_project("control", "battery.display", raw)
            })
        }

        Label "onyrion-quicksettings-power-state-0" {
            text = global("onyrion_control").mutate(|raw| {
                return onyrion_scalar_project("control", "power_profile.display", raw)
            })
        }

        Box {
            spacing = 8
            class = "onyrion-quicksettings-profiles"

            Button "onyrion-profile-power-saver-0" {
                label = "Saver"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} power-profile set power-saver"
            }

            Button "onyrion-profile-balanced-0" {
                label = "Balanced"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} power-profile set balanced"
            }

            Button "onyrion-profile-performance-0" {
                label = "Performance"
                onclick = "${ONYRION_CONTROL_BIN:-onyrion-control} power-profile set performance"
            }
        }

        Button "onyrion-quicksettings-audio-mixer-0" {
            label = "Audio mixer"
            onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} open --screen 0 --toggle onyrion-audio-mixer"
            class = "onyrion-shell-control"
        }

        Button "onyrion-quicksettings-close-0" {
            label = "Close"
            onclick = "ewwii --config ${ONYRION_UI_DIR:-/usr/share/onyrion/ui/ewwii} close onyrion-quicksettings-0"
            class = "onyrion-quicksettings-close"
        }
    }
}

